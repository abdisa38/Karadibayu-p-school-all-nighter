# Node Environment
NODE_ENV=development
PORT=5000

# Client and Server URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# MongoDB Connection String (Replace with your Atlas or local connection)
MONGODB_URI=mongodb://127.0.0.1:27017/karadibayu_school_db

# Security & Authentication Secrets (Replace with high-entropy cryptographic strings in production)
JWT_SECRET=karadibayu_institutional_jwt_super_secret_key_2026_min32chars
JWT_REFRESH_SECRET=karadibayu_institutional_refresh_secret_key_2026_min32chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Logging Level (debug, info, warn, error)
LOG_LEVEL=debug
